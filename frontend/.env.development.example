# Next.js sets NODE_ENV=development when running `npm run dev`.
NEXT_PUBLIC_API_URL=http://localhost:3010/api/v1
NEXT_PUBLIC_NOTIFICATION_URL=http://localhost:3005
NEXT_PUBLIC_FILE_URL=http://localhost:3006

# Public config values are bundled into browser code; do not put server secrets here.
NEXT_PUBLIC_SECRET_KEY=development-public-config-placeholder
NEXT_PUBLIC_TICK_DONE=/sounds/tick-done.mp3
NEXT_PUBLIC_BUBBLE=/sounds/bubble.mp3
