# Email delivery uses the Resend HTTPS API, not SMTP.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Verify toboco.click in Resend before using this sender.
EMAIL_FROM="Toboco <noreply@toboco.click>"
APP_URL=https://toboco.click
RABBITMQ_URI=amqps://user:password@rabbitmq.example.com:5671/%2F
