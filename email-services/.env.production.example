NODE_ENV=production
PORT=3001
RABBITMQ_URI=amqps://<user>:<password>@<rabbitmq-host>:5671/%2F

# Use a production SMTP provider and store credentials as deployment secrets.
HOST_SMTP=<smtp-host>
PORT_SMTP=587
AUTH_GOOGLE_EMAIL=<sender-email>
AUTH_GOOGLE_PASS=<smtp-app-password>
FRONT_END_URL=https://<your-frontend-domain>
