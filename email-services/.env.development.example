NODE_ENV=development
PORT=3001
RABBITMQ_URI=amqp://guest:guest@localhost:5672/%2F

# MailHog is exposed on host port 3050 by docker-compose.yml.
HOST_SMTP=localhost
PORT_SMTP=3050
AUTH_GOOGLE_EMAIL=developer@example.com
AUTH_GOOGLE_PASS=replace-with-a-local-app-password-if-needed
FRONT_END_URL=http://localhost:3000
