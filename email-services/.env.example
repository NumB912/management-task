# =============================================
# RabbitMQ Configuration
# =============================================

# =============================================
# SMTP Configuration
# =============================================
HOST_SMTP=your-smtp-host
PORT_SMTP=1025
AUTH_GOOGLE_EMAIL=your-email@gmail.com

# =============================================
# Frontend
# =============================================
FRONT_END_URL=http://your-frontend-host:3030
RABBITMQ_URI="amqp://your-rabbitmq-user:your-rabbitmq-password@your-rabbitmq-host:5672/%2F?heartbeat=30"

# Email provider: smtp (local) or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=Task Management <developer@example.com>
RESEND_API_KEY=re_replace_with_your_api_key
