NODE_ENV=production
PORT=3006
RABBITMQ_URI=amqps://<user>:<password>@<rabbitmq-host>:5671/%2F
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
FILE_BASE_URL=https://<your-file-service-domain>

# Configure R2 credentials in the deployment secret manager.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<r2-bucket-name>
R2_PUBLIC_URL=https://<your-r2-public-domain>
