# Set these values in the deployment platform before building the Next.js app.
NEXT_PUBLIC_API_URL=https://<your-api-domain>/api/v1
NEXT_PUBLIC_NOTIFICATION_URL=https://<your-notifier-domain>
NEXT_PUBLIC_FILE_URL=https://<your-file-service-domain>

# NEXT_PUBLIC_* values are visible to every browser user and are not secrets.
NEXT_PUBLIC_SECRET_KEY=production-public-config-placeholder
NEXT_PUBLIC_TICK_DONE=/sounds/tick-done.mp3
NEXT_PUBLIC_BUBBLE=/sounds/bubble.mp3
