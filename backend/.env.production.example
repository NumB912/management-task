NODE_ENV=production
PORT=3010

# Replace all placeholders with production service credentials/URLs.
MONGODB_URI=mongodb://user:password@mongodb:27017/toboco?authSource=admin
REDIS_URI=redis://redis:6379
CACHE_HOST=<redis-host>
CACHE_PORT=<redis-port>
RABBITMQ_URI=amqp://user:password@rabbitmq:5672/%2F?heartbeat=30
SECRET_KEY=replace_with_a_strong_random_secret
APP_URL=https://<your-frontend-domain>
FRONTEND_URL=https://<your-frontend-domain>

# Google OAuth Web application (server-only credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback
