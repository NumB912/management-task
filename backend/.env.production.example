NODE_ENV=production
PORT=3010

# Replace all placeholders with production service credentials/URLs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REDIS_URI=rediss://<user>:<password>@<redis-host>:<port>
CACHE_HOST=<redis-host>
CACHE_PORT=<redis-port>
RABBITMQ_URI=amqps://<user>:<password>@<rabbitmq-host>:5671/%2F
SECRET_KEY=replace-with-a-unique-long-random-production-secret
APP_URL=https://<your-frontend-domain>
FRONTEND_URL=https://<your-frontend-domain>

# Google OAuth Web application (server-only credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback
