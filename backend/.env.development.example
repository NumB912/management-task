NODE_ENV=development
PORT=3010

# Local services from docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/task-management?replicaSet=rs0
CACHE_HOST=localhost
CACHE_PORT=6379
RABBITMQ_URI=amqp://guest:guest@localhost:5672/%2F

# Generate a local-only random value (for example: openssl rand -base64 48)
SECRET_KEY=replace-with-a-long-random-development-secret
APP_URL=http://localhost:3000
