# Copy to .env.dependencies and supply actual connection details.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
REDIS_URI=redis://default:PASSWORD@HOST:PORT
# RabbitMQ check verifies TCP connectivity only. Use the public proxy port
# when Docker runs outside Railway's private network.
RABBITMQ_HOST=your-rabbitmq-host
RABBITMQ_PORT=5672
